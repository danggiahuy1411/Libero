<UserControl x:Class="Libero.Controls.PopupAccountMenuControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>
        <Style x:Key="AccountMenuItemStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="6"/>
            <Setter Property="materialDesign:RippleAssist.Feedback" Value="{DynamicResource AccentBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LogoutMenuItemStyle" TargetType="Button" BasedOn="{StaticResource AccountMenuItemStyle}">
            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="materialDesign:RippleAssist.Feedback" Value="{DynamicResource ErrorBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <materialDesign:PopupBox PlacementMode="BottomAndAlignRightEdges"
                             StaysOpen="False"
                             Padding="0"
                             PopupElevation="Dp8">
        <!-- Nút bấm trên Header -->
        <materialDesign:PopupBox.ToggleContent>
            <Border Background="Transparent" Padding="6,4" CornerRadius="8" Cursor="Hand">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="{Binding UserInitials, FallbackValue='AL'}"
                                   Foreground="{DynamicResource SidebarTextBrush}"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="10,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UserName, FallbackValue='Lê Minh Anh'}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <TextBlock Text="{Binding UserRoleDisplay, FallbackValue='Nhân viên'}"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="11"/>
                    </StackPanel>

                    <materialDesign:PackIcon Kind="ChevronDown"
                                             Foreground="{DynamicResource TextMutedBrush}"
                                             VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </materialDesign:PopupBox.ToggleContent>

        <!-- Menu nổi đè lên nội dung -->
        <Border Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Width="210"
                Padding="6"
                Effect="{DynamicResource CardShadowEffect}">
            <StackPanel>
                <Button Style="{StaticResource AccountMenuItemStyle}" Command="{Binding OpenProfileCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountOutline" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Hồ sơ cá nhân"/>
                    </StackPanel>
                </Button>

                <Separator Background="{DynamicResource BorderBrush}" Margin="6,4"/>

                <Button Style="{StaticResource LogoutMenuItemStyle}" Command="{Binding LogoutCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Logout" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Đăng xuất"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </materialDesign:PopupBox>
</UserControl>