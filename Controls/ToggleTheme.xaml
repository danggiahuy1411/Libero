<UserControl x:Class="Libero.Controls.ToggleTheme"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             Width="84"
             Height="40"
             Focusable="False">

    <Grid>
        <!-- Viền ngoài (84x40, trừ viền 1px còn 82x38) -->
        <Border Background="{DynamicResource BackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="20"/>

        <!-- Vùng nội dung 76x32 -> Chia đôi mỗi cột đúng 38x32 -->
        <Grid Margin="3">

            <!-- Nút trượt tròn: đặt trong cột 38x32 với HorizontalAlignment="Center" để tâm trùng khít icon -->
            <Grid Width="38" HorizontalAlignment="Left" Panel.ZIndex="1">
                <Border x:Name="ToggleThumb"
                        Width="32"
                        Height="32"
                        CornerRadius="16"
                        Background="{DynamicResource PrimaryBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="ThumbTransform"/>
                    </Border.RenderTransform>
                </Border>
            </Grid>

            <!-- 2 Cột Icon (mỗi cột 38x32) -->
            <Grid Panel.ZIndex="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Cột 0: Mặt trời (Canvas 24x24 đồng bộ tỉ lệ với Mặt trăng) -->
                <Viewbox Grid.Column="0" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Ellipse x:Name="SunCircle"
                                 Canvas.Left="7"
                                 Canvas.Top="7"
                                 Width="10"
                                 Height="10"
                                 Stroke="{DynamicResource SurfaceBrush}"
                                 StrokeThickness="2"/>

                        <Path x:Name="SunRays"
                              Data="M 12,1.5 L 12,3.8
                                    M 12,20.2 L 12,22.5
                                    M 1.5,12 L 3.8,12
                                    M 20.2,12 L 22.5,12
                                    M 4.6,4.6 L 6.2,6.2
                                    M 17.8,17.8 L 19.4,19.4
                                    M 4.6,19.4 L 6.2,17.8
                                    M 17.8,6.2 L 19.4,4.6"
                              Stroke="{DynamicResource SurfaceBrush}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>

                <!-- Cột 1: Mặt trăng (Canvas 24x24 chuẩn hình học) -->
                <Viewbox Grid.Column="1" Width="17" Height="17" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="MoonIcon"
                              Data="M 21,12.79 A 9,9 0 1,1 11.21,3 A 7,7 0 0,0 21,12.79 Z"
                              Stroke="{DynamicResource TextMutedBrush}"
                              StrokeThickness="2"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Fill="Transparent"/>
                    </Canvas>
                </Viewbox>
            </Grid>

            <!-- Vùng bấm -->
            <Button Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Focusable="False"
                    Cursor="Hand"
                    Command="{Binding ToggleCommand, ElementName=Root}"
                    Panel.ZIndex="3">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </Grid>
    </Grid>
</UserControl>