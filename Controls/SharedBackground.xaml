<UserControl x:Class="Libero.Controls.SharedBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Libero.Models"
             IsHitTestVisible="False">

    <Grid Background="{DynamicResource BackgroundBrush}">

        <ItemsControl ItemsSource="{Binding BackgroundIcons,
                    RelativeSource={RelativeSource AncestorType=UserControl}}">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <Canvas ClipToBounds="True"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemContainerStyle>
                <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}"/>
                    <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                </Style>
            </ItemsControl.ItemContainerStyle>

            <ItemsControl.ItemTemplate>
                <DataTemplate>

                    <Viewbox Width="{Binding Size}"
                             Height="{Binding Size}"
                             Opacity="{Binding Opacity}"
                             RenderTransformOrigin="0.5,0.5">

                        <Viewbox.RenderTransform>
                            <RotateTransform Angle="{Binding Angle}"/>
                        </Viewbox.RenderTransform>

                        <Canvas Width="32" Height="32">

                            <!-- APPLE -->
                            <Canvas>
                                <Canvas.Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconType}"
                                                Value="{x:Static models:BackgroundIconType.Apple}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Canvas.Style>

                                <Path Data="M 16,10.5 C 12.5,8.5 7,10.5 7,17 C 7,23.5 11.5,28 14.5,28 C 15.5,28 16,27.5 16,27.5 C 16,27.5 16.5,28 17.5,28 C 20.5,28 25,23.5 25,17 C 25,10.5 19.5,8.5 16,10.5 Z"
                                      Stroke="{DynamicResource AppleIconBrush}"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round"/>

                                <Path Data="M 16,10.5 C 16,7.5 17.2,5 19,4"
                                      Stroke="{DynamicResource AppleIconBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>

                                <Path Data="M 16,8.5 C 15.5,5.5 12.5,4.5 10.5,5.5 C 11,8 13.5,9 16,8.5 Z"
                                      Stroke="{DynamicResource AppleIconBrush}"
                                      StrokeThickness="1.6"
                                      StrokeLineJoin="Round"/>

                                <Path Data="M 10.5,14.5 C 10,16.5 10.2,19 11.2,21"
                                      Stroke="{DynamicResource AppleIconBrush}"
                                      StrokeThickness="1.5"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>

                            <!-- OPEN BOOK -->
                            <Canvas>
                                <Canvas.Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconType}"
                                                Value="{x:Static models:BackgroundIconType.OpenBook}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Canvas.Style>

                                <Path Data="M 16,9 C 12,6 6,7 4,9 L 4,25 C 8,23 12,23 16,27 C 20,23 24,23 28,25 L 28,9 C 26,7 20,6 16,9 Z"
                                      Stroke="{DynamicResource BookIconBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round"/>

                                <Path Data="M 16,9 L 16,27"
                                      Stroke="{DynamicResource BookIconBrush}"
                                      StrokeThickness="1.5"/>

                                <Path Data="M 7,12 C 10,11 12,12 14,14 M 7,17 C 10,16 12,17 14,19 M 18,14 C 21,12 23,11 26,12 M 18,19 C 21,17 23,16 26,17"
                                      Stroke="{DynamicResource BookIconBrush}"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"/>
                            </Canvas>

                            <!-- CLOSED BOOK -->
                            <Canvas>
                                <Canvas.Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconType}"
                                                Value="{x:Static models:BackgroundIconType.Book}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Canvas.Style>

                                <Path Data="M 7,5 C 7,4 9,4 11,5 L 26,8 L 26,26 L 10,23 C 8,22.5 7,23 7,24 Z"
                                      Stroke="{DynamicResource BookIconBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round"/>

                                <Path Data="M 7,5 L 7,24 M 11,5 L 11,23"
                                      Stroke="{DynamicResource BookIconBrush}"
                                      StrokeThickness="1.4"/>

                                <Path Data="M 14,11 L 23,13 M 14,15 L 23,17"
                                      Stroke="{DynamicResource BookIconBrush}"
                                      StrokeThickness="1.2"
                                      StrokeStartLineCap="Round"/>
                            </Canvas>

                            <!-- BOOKMARK -->
                            <Canvas>
                                <Canvas.Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconType}"
                                                Value="{x:Static models:BackgroundIconType.Bookmark}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Canvas.Style>

                                <Path Data="M 9,5 L 23,5 L 23,27 L 16,22 L 9,27 Z"
                                      Stroke="{DynamicResource BookmarkIconBrush}"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round"/>
                            </Canvas>

                            <!-- PENCIL -->
                            <Canvas>
                                <Canvas.Style>
                                    <Style TargetType="Canvas">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IconType}"
                                                Value="{x:Static models:BackgroundIconType.Pencil}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Canvas.Style>

                                <Path Data="M 7,23 L 9,27 L 13,25 L 25,13 L 21,9 Z"
                                      Stroke="{DynamicResource PencilIconBrush}"
                                      StrokeThickness="1.8"
                                      StrokeLineJoin="Round"/>

                                <Path Data="M 21,9 L 24,6 L 28,10 L 25,13 M 9,27 L 8,29"
                                      Stroke="{DynamicResource PencilIconBrush}"
                                      StrokeThickness="1.7"
                                      StrokeLineJoin="Round"/>
                            </Canvas>

                        </Canvas>
                    </Viewbox>
                </DataTemplate>
            </ItemsControl.ItemTemplate>

        </ItemsControl>
    </Grid>
</UserControl>