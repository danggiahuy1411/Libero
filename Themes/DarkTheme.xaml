<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Colors -->
    <Color x:Key="PrimaryColor">#E6CDB0</Color>
    <Color x:Key="AccentColor">#A97852</Color>
    <Color x:Key="GoldColor">#C49A5A</Color>
    <Color x:Key="BackgroundColor">#241A15</Color>
    <Color x:Key="SurfaceColor">#2E221C</Color>
    <Color x:Key="TextPrimaryColor">#F1E7DB</Color>
    <Color x:Key="TextMutedColor">#B3A090</Color>
    <Color x:Key="BorderColor">#4A3A31</Color>
    <Color x:Key="SurfaceHoverColor">#382A22</Color>
    <Color x:Key="SidebarColor">#1B130F</Color>
    <Color x:Key="SidebarTextColor">#F5EDE3</Color>

    <!-- Status Colors -->
    <Color x:Key="SuccessColor">#65734B</Color>
    <Color x:Key="SuccessSoftColor">#323A27</Color>
    <Color x:Key="WarningColor">#A77A3A</Color>
    <Color x:Key="WarningSoftColor">#3F3320</Color>
    <Color x:Key="ErrorColor">#A65345</Color>
    <Color x:Key="ErrorSoftColor">#47272A</Color>
    <Color x:Key="InfoSoftColor">#33403F</Color>

    <!-- SolidColorBrushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource GoldColor}" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoftColor}" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoSoftColor}" />

    <!-- Gradients (Hero & Book Cover) -->
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A3428" Offset="0.0" />
        <GradientStop Color="#76543F" Offset="1.0" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#4A3428" Offset="0.0" />
        <GradientStop Color="#8A6247" Offset="0.65" />
        <GradientStop Color="#C49A5A" Offset="1.0" />
    </LinearGradientBrush>

    <!-- Card Shadow -->
    <DropShadowEffect x:Key="CardShadowEffect"
                      Color="#000000"
                      Opacity="0.35"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270" />

    <!-- Background Icons -->
    <SolidColorBrush x:Key="AppleIconBrush"
                 Color="#FFE69AAE"/>

    <SolidColorBrush x:Key="BookIconBrush"
                 Color="#FFBCA3ED"/>

    <SolidColorBrush x:Key="BookmarkIconBrush"
                 Color="#FFE4A4C8"/>

    <SolidColorBrush x:Key="PencilIconBrush"
                 Color="#FFE5C28B"/>

</ResourceDictionary>