<UserControl x:Class="Libero.Views.AccountSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:Libero.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <!-- Chỉ định nghĩa thêm phần căn chỉnh riêng cho Card của trang này -->
        <Style x:Key="SettingCardStyle" TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <controls:SharedBackground/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="36,24,36,36">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 1. Tiêu đề trang -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="Tài khoản"
                               FontSize="32"
                               Foreground="{DynamicResource PrimaryBrush}"
                               FontWeight="Bold"/>
                    <TextBlock Text="Thông tin cá nhân"
                               FontSize="16"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 2. Hai Card responsive -->
                <Grid x:Name="CardsGrid" Grid.Row="1" SizeChanged="CardsGrid_SizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition x:Name="GapColumn" Width="24"/>
                        <ColumnDefinition x:Name="RightColumn" Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition x:Name="GapRow" Height="0"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- CARD TRÁI: HỒ SƠ -->
                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SettingCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Hồ sơ"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,20"/>

                            <Label Content="Họ tên" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtFullName}"/>
                            <TextBox x:Name="txtFullName"
                                     Style="{StaticResource AppTextBoxStyle}"
                                     Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <Label Content="Email" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtEmail}"/>
                            <TextBox x:Name="txtEmail"
                                     Style="{StaticResource AppTextBoxStyle}"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <Label Content="SĐT" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtPhone}"/>
                            <TextBox x:Name="txtPhone"
                                     Style="{StaticResource AppTextBoxStyle}"
                                     Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <Label Content="Thẻ SV / CCCD" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtIdCard}"/>
                            <TextBox x:Name="txtIdCard"
                                     Style="{StaticResource AppTextBoxStyle}"
                                     Text="{Binding IdentityCard, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <Button Content="Lưu thay đổi"
                                    Command="{Binding SaveProfileCommand}"
                                    Style="{StaticResource AppPrimaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- CARD PHẢI: ĐỔI MẬT KHẨU -->
                    <Border x:Name="PasswordCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource SettingCardStyle}">
                        <StackPanel>
                            <TextBlock Text="Đổi mật khẩu"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Margin="0,0,0,20"/>

                            <Label Content="Mật khẩu hiện tại" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtCurrentPass}"/>
                            <PasswordBox x:Name="txtCurrentPass"
                                         Style="{StaticResource AppPasswordBoxStyle}"
                                         materialDesign:PasswordBoxAssist.Password="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <Label Content="Mật khẩu mới" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtNewPass}"/>
                            <PasswordBox x:Name="txtNewPass"
                                         Style="{StaticResource AppPasswordBoxStyle}"
                                         materialDesign:PasswordBoxAssist.Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <Label Content="Nhập lại" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtConfirmPass}"/>
                            <PasswordBox x:Name="txtConfirmPass"
                                         Style="{StaticResource AppPasswordBoxStyle}"
                                         materialDesign:PasswordBoxAssist.Password="{Binding ConfirmNewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"/>

                            <Button Content="Cập nhật"
                                    Command="{Binding ChangePasswordCommand}"
                                    Style="{StaticResource AppOutlinedButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>