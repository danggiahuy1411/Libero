<UserControl x:Class="Libero.Views.LoginSignupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Libero.Views"
             xmlns:controls="clr-namespace:Libero.Controls"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1280">

    <UserControl.Resources>
        <!-- Kế thừa từ base style trong Styles.xaml -->
        <Style x:Key="AuthTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
            <Setter Property="materialDesign:TextFieldAssist.HasLeadingIcon" Value="True"/>
        </Style>

        <Style x:Key="AuthPasswordBoxStyle" TargetType="PasswordBox" BasedOn="{StaticResource AppPasswordBoxStyle}">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,22"/>
            <Setter Property="materialDesign:TextFieldAssist.HasLeadingIcon" Value="True"/>
        </Style>

        <Style x:Key="AuthPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppPrimaryButtonStyle}">
            <Setter Property="Margin" Value="30,10,30,20"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <Border CornerRadius="45"
                    MaxHeight="620"
                    MaxWidth="1050"
                    Margin="20"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    Effect="{DynamicResource CardShadowEffect}">
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border CornerRadius="45"
                                    Background="Black"
                                    Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Border}}"
                                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Border}}"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>

                <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged" ClipToBounds="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="LeftColumn" Width="5*" MinWidth="0"/>
                        <ColumnDefinition x:Name="RightColumn" Width="6*" MinWidth="0"/>
                    </Grid.ColumnDefinitions>

                    <!-- ================= CỘT TRÁI (SIDEBAR BRANDING) ================= -->
                    <Grid x:Name="LeftPanel" Grid.Column="0" MinWidth="350" ClipToBounds="True" Background="{DynamicResource SidebarBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Margin="10,36,10,0" Orientation="Horizontal">
                            <Border Width="40" Height="40" Margin="20,0,10,0" Background="#F6EED9" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="2" CornerRadius="15">
                                <Image Source="pack://application:,,,/Libero;component/Assets/mini-logo.png" Stretch="Uniform" Margin="1"/>
                            </Border>
                            <TextBlock Text="LIBERO" FontFamily="EB Garamond" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource SidebarTextBrush}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Width="216" Height="280" Margin="40,16" Background="#F6EED9" BorderBrush="{DynamicResource GoldBrush}" BorderThickness="3" CornerRadius="110,110,25,25">
                                <Image Source="pack://application:,,,/Libero;component/Assets/logo-image.png" Stretch="Uniform" Margin="15"/>
                            </Border>
                            <TextBlock Text="READ · LEARN · GROW" Grid.Row="1" FontSize="20" FontFamily="Segoe UI" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource GoldBrush}"/>
                        </Grid>

                        <Border Margin="40,16" Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1.5" CornerRadius="12" Grid.Row="2" Padding="10,6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Giờ mở cửa thư viện" FontFamily="Arial" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SidebarTextBrush}" Margin="10,0" VerticalAlignment="Center"/>

                                    <TextBlock Text="{Binding StatusText}" FontSize="15" FontWeight="SemiBold" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#EF5350"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOperating}" Value="True">
                                                        <Setter Property="Foreground" Value="#81C784"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border BorderBrush="#33FFFFFF" BorderThickness="1" Margin="5" CornerRadius="12" Background="#33000000">
                                        <StackPanel>
                                            <TextBlock Text="MỞ CỬA" FontFamily="Arial" FontSize="11" Foreground="#D7C8B8" Margin="16,10,16,0"/>
                                            <TextBlock Text="{Binding OpenHours}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextBrush}" HorizontalAlignment="Left" Margin="16,0,16,10"/>
                                        </StackPanel>
                                    </Border>

                                    <Border BorderBrush="#33FFFFFF" Grid.Column="1" BorderThickness="1" Margin="5" CornerRadius="12" Background="#33000000">
                                        <StackPanel>
                                            <TextBlock Text="ĐÓNG CỬA" FontFamily="Arial" FontSize="11" Foreground="#D7C8B8" Margin="16,10,16,0"/>
                                            <TextBlock Text="{Binding CloseHours}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SidebarTextBrush}" HorizontalAlignment="Left" Margin="16,0,16,10"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <TextBlock Text="Thứ 2 – Thứ 7 · Chủ nhật nghỉ" FontFamily="Arial" FontSize="12" Foreground="#D7C8B8" Margin="16,4,16,4"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ================= CỘT PHẢI (FORM ĐĂNG NHẬP / ĐĂNG KÝ) ================= -->
                    <StackPanel x:Name="RightPanel" Grid.Column="1" MinWidth="420" Background="{DynamicResource SurfaceBrush}">
                        <StackPanel.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
                        </StackPanel.Resources>

                        <!-- Thanh chuyển Tab -->
                        <Grid Background="{DynamicResource SurfaceBrush}" Margin="30,20,30,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="1" Grid.ColumnSpan="2" Height="1" Background="{DynamicResource BorderBrush}" VerticalAlignment="Bottom"/>
                            <RadioButton x:Name="TabLogin" IsChecked="{Binding IsLoginTabSelected}" Grid.Column="0" Grid.RowSpan="2" Content="Đăng nhập" Style="{StaticResource AuthTabStyle}"/>
                            <RadioButton x:Name="TabRegister" IsChecked="{Binding IsRegisterTabSelected}" Grid.Column="1" Grid.RowSpan="2" Content="Đăng ký" Style="{StaticResource AuthTabStyle}"/>
                        </Grid>

                        <!-- ================= FORM ĐĂNG NHẬP ================= -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=TabLogin, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="30,10,30,0">
                                <Label Content="_Tên đăng nhập / Số điện thoại" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtAccount}"/>
                                <TextBox x:Name="txtAccount"
                                         Style="{StaticResource AuthTextBoxStyle}"
                                         Text="{Binding Account, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         materialDesign:HintAssist.Hint="Nguyễn Văn A"
                                         materialDesign:TextFieldAssist.LeadingIcon="AccountOutline"/>

                                <Label Content="_Mật khẩu" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtPassword}"/>
                                <PasswordBox x:Name="txtPassword"
                                             Style="{StaticResource AuthPasswordBoxStyle}"
                                             materialDesign:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             materialDesign:HintAssist.Hint="Password"/>
                            </StackPanel>

                            <Button Content="Đăng nhập"
                                    Command="{Binding LoginCommand}"
                                    Style="{StaticResource AuthPrimaryButtonStyle}"/>
                        </StackPanel>

                        <!-- ================= FORM ĐĂNG KÝ ================= -->
                        <StackPanel Visibility="{Binding IsChecked, ElementName=TabRegister, Converter={StaticResource BoolToVis}}">
                            <StackPanel Margin="30,10,30,0">
                                <Label Content="_Tên đăng nhập" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtRegAccount}"/>
                                <TextBox x:Name="txtRegAccount"
                                         Style="{StaticResource AuthTextBoxStyle}"
                                         Text="{Binding RegAccount, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         materialDesign:HintAssist.Hint="Nguyễn Văn A"
                                         materialDesign:TextFieldAssist.LeadingIcon="AccountOutline"/>

                                <Label Content="_Số điện thoại" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtRegPhone}"/>
                                <TextBox x:Name="txtRegPhone"
                                         Style="{StaticResource AuthTextBoxStyle}"
                                         Text="{Binding RegPhone, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                         materialDesign:HintAssist.Hint="0123456789"
                                         materialDesign:TextFieldAssist.LeadingIcon="PhoneOutline"/>

                                <Label Content="_Mật khẩu" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtRegPassword}"/>
                                <PasswordBox x:Name="txtRegPassword"
                                             Style="{StaticResource AuthPasswordBoxStyle}"
                                             materialDesign:PasswordBoxAssist.Password="{Binding RegPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             materialDesign:HintAssist.Hint="Password"/>

                                <Label Content="_Nhập lại mật khẩu" Style="{StaticResource FormLabelStyle}" Target="{Binding ElementName=txtConfirmPassword}"/>
                                <PasswordBox x:Name="txtConfirmPassword"
                                             Style="{StaticResource AuthPasswordBoxStyle}"
                                             materialDesign:PasswordBoxAssist.Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                             materialDesign:HintAssist.Hint="Password"/>
                            </StackPanel>

                            <Button Content="Tạo tài khoản"
                                    Command="{Binding RegisterCommand}"
                                    Style="{StaticResource AuthPrimaryButtonStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </ScrollViewer>

        <materialDesign:Snackbar x:Name="ToastSnackbar"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Bottom"
                                 Margin="24"
                                 Background="{DynamicResource PrimaryBrush}"
                                 Foreground="{DynamicResource SurfaceBrush}"
                                 MessageQueue="{Binding ToastQueue}">
            <materialDesign:Snackbar.Resources>
                <Style TargetType="materialDesign:SnackbarMessage">
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize" Value="14"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Style>
                <SolidColorBrush x:Key="SecondaryHueMidBrush" Color="{DynamicResource GoldColor}"/>
            </materialDesign:Snackbar.Resources>
        </materialDesign:Snackbar>

        <controls:ToggleTheme Width="84" Height="40"
                              IsDarkMode="{Binding DataContext.IsDarkMode, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}"
                              ToggleCommand="{Binding DataContext.ToggleThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,20,0"/>
    </Grid>
</UserControl>